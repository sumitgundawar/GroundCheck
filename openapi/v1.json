            "title": "Proposed"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "status": {
            "enum": [
              "match",
              "mismatch",
              "unverifiable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ProposalDimension",
        "type": "object"
      },
      "Redaction": {
        "description": "What the PII layer removed from the question: counts by kind, and the\nquestion with placeholders. Never the removed values.",
