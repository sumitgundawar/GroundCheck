            "type": "string"
          },
          "source": {
            "default": "",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "medicine",
          "message"
        ],
        "title": "PatientFinding",
        "type": "object"
      },
      "ProposalCheck": {
        "description": "What a question that proposes a regimen was found to say, compared with\nthe source: `match` (every part is the source's), `mismatch` (a part\ndiffers) or `unverifiable` (a part cannot be read or checked).",
        "properties": {
          "dimensions": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ProposalDimension"
            },
            "title": "Dimensions",
            "type": "array"
          },
          "drug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drug"
          },
          "status": {
            "enum": [
              "match",
              "mismatch",
              "unverifiable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ProposalCheck",
        "type": "object"
      },
      "ProposalDimension": {
        "description": "One part of a proposed regimen and how it compares with the source.",
