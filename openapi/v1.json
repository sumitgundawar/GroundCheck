          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          }
        },
        "title": "Explanation",
        "type": "object"
      },
      "PatientContext": {
        "additionalProperties": false,
        "description": "The patient a question is about. Every field is optional, but a dose\nquestion for a medicine whose rules need a value (for example kidney\nfunction) is refused until that value is given. There's deliberately no\nfield for names or record numbers.",
        "properties": {
          "age_years": {
            "anyOf": [
              {
                "maximum": 130.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Years"
          },
          "allergies": {
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "title": "Allergies",
            "type": "array"
          },
          "breastfeeding": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Breastfeeding"
          },
          "child_pugh": {
            "anyOf": [
              {
                "enum": [
                  "A",
                  "B",
                  "C"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Child Pugh"
          },
          "conditions": {
            "items": {
              "type": "string"
            },
            "maxItems": 40,
            "title": "Conditions",
            "type": "array"
          },
          "creatinine_umol_l": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 3000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Creatinine Umol L"
          },
          "egfr": {
            "anyOf": [
              {
                "maximum": 200.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "mL/min/1.73 m2",
            "title": "Egfr"
          },
          "labs": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "potassium",
                "sodium",
                "inr",
                "platelets",
                "alt",
                "qtc"
              ]
            },
            "title": "Labs",
            "type": "object"
          },
          "medicines": {
            "items": {
              "type": "string"
            },
            "maxItems": 40,
            "title": "Medicines",
            "type": "array"
          },
          "pregnant": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pregnant"
          },
          "sex": {
            "anyOf": [
              {
                "enum": [
                  "female",
                  "male",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          },
          "weight_kg": {
            "anyOf": [
              {
                "maximum": 400.0,
                "minimum": 0.3,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Kg"
          }
        },
        "title": "PatientContext",
        "type": "object"
      },
      "PatientFinding": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "medicine": {
