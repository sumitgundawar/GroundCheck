{
  "components": {
    "schemas": {
      "AskResponse": {
        "properties": {
          "answer_text": {
            "title": "Answer Text",
            "type": "string"
          },
          "audit_id": {
            "title": "Audit Id",
            "type": "string"
          },
          "claims": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "title": "Claims",
            "type": "array"
          },
          "decision": {
            "enum": [
              "answer",
              "refuse"
            ],
            "title": "Decision",
            "type": "string"
          },
          "explanation": {
            "$ref": "#/components/schemas/Explanation",
            "default": {
              "missing_terms": [],
              "suggestions": [],
              "summary": ""
            }
          },
          "llm_used": {
            "title": "Llm Used",
            "type": "boolean"
          },
          "outcome": {
            "default": "refused",
            "enum": [
              "answered",
              "refused",
              "not_evaluated"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "patient_findings": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PatientFinding"
            },
            "title": "Patient Findings",
            "type": "array"
          },
          "proposal_check": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProposalCheck"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_code": {
            "anyOf": [
              {
                "enum": [
                  "input_blocked",
                  "rate_limited",
                  "no_relevant_source",
                  "term_not_covered",
                  "population_not_covered",
                  "stated_value_unsupported",
                  "form_unsupported",
                  "limit_not_stated",
                  "combination_forbidden",
                  "insufficient_context",
                  "claim_ungrounded",
                  "dose_unsupported",
                  "patient_unsafe",
                  "unsupported_language",
                  "proposal_unverifiable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "reason_params": {
            "additionalProperties": true,
            "default": {},
            "title": "Reason Params",
            "type": "object"
          },
          "redaction": {
            "$ref": "#/components/schemas/Redaction",
            "default": {
              "kinds": {},
              "redacted_query": ""
            }
          },
          "refused_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refused Reason"
          },
          "review": {
            "$ref": "#/components/schemas/Review",
            "default": {
              "note": "",
              "routed": false
            }
          },
          "sources": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "total_ms": {
            "title": "Total Ms",
            "type": "integer"
          },
          "trace": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "decision",
          "answer_text",
          "audit_id",
          "total_ms",
          "llm_used"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "Claim": {
        "properties": {
          "grounded": {
            "default": false,
