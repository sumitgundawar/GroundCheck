# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The name people use to reach GroundCheck, for example groundcheck.trust.nhs.uk
GROUNDCHECK_HOSTNAME=groundcheck.internal.example
# "internal", an email address for Let's Encrypt, or "cert.pem key.pem" paths (see Caddyfile)
TLS_SETTING=internal

# Database password: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Keys: python -m app.cli generate-key (or docker compose run --rm app python -m app.cli generate-key).
# Store copies in your secrets manager. Losing DATA_ENCRYPTION_KEYS loses the encrypted data.
DATA_ENCRYPTION_KEYS=
AUDIT_SIGNING_KEYS=

# Retention, in days. 0 keeps records for ever. Agree these with information governance.
AUDIT_RETENTION_DAYS=0
REVIEW_RETENTION_DAYS=0

# Single sign-on (see README, "Single sign-on"). Leave OIDC_ISSUER empty for passwords only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=
OIDC_ROLES_CLAIM=roles
OIDC_ADMIN_VALUES=
OIDC_REVIEWER_VALUES=
OIDC_DEFAULT_ROLE=clinician
OIDC_ALLOWED_DOMAINS=
OIDC_REQUIRE_MFA=true
PASSWORD_SIGN_IN=true
OIDC_SITE_CLAIM=
OIDC_ALL_SITES_VALUE=

# EHR integration (see README, "EHR integration")
SMART_CLIENT_ID=
SMART_CLIENT_SECRET=
SMART_ALLOWED_ISSUERS=
SMART_WRITE_NOTES=false
CDS_HOOKS_TRUSTED=

# Monitoring (see README, "Monitoring and alerts")
METRICS_TOKEN=
ALERT_WEBHOOK_URL=
INSTANCE_NAME=

# CT and MRI imaging (see README, "CT and MRI")
ORGANISATION_NAME=
# Your PACS or VNA over DICOMweb. With --profile pacs, the test Orthanc PACS is
# http://pacs:8042/dicom-web and DICOMWEB_AUTHORIZATION is "Basic " followed by
# base64 of groundcheck:PACS_PASSWORD.
DICOMWEB_URL=
DICOMWEB_AUTHORIZATION=
PACS_PASSWORD=
IMAGING_MAX_UPLOAD_MB=1024

# Documents only: set false to answer from your approved documents alone.
INCLUDE_DEMO_CORPUS=false
FORCE_EXTRACTIVE=false
API_DOCS=false

# Folder on the host with image datasets for the training studio, mounted read-only.
DATASETS_DIR=./datasets
