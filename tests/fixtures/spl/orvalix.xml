      <component>
        <section>
          <code code="34067-9"/>
          <title>INDICATIONS AND USAGE</title>
          <text><paragraph>Orvalix oral solution is indicated for relief of fictional tremor episodes.</paragraph></text>
        </section>
      </component>
      <component>
        <section>
          <code code="34068-7"/>
          <title>DOSAGE AND ADMINISTRATION</title>
          <text>
            <paragraph>Adults: 5 to 10 mL (25 to 50 mg) every 6 hours as needed. Do not exceed 40 mL in 24 hours.</paragraph>
            <paragraph>Children 2 to 5 years: 2.5 mL (12.5 mg) every 6 hours. Pediatric dosing may also be calculated as 0.25 mg/kg per dose.</paragraph>
          </text>
        </section>
      </component>
      <component>
        <section>
          <code code="34070-3"/>
          <title>CONTRAINDICATIONS</title>
          <text><paragraph>None known.</paragraph></text>
        </section>
      </component>
    </structuredBody>
  </component>
