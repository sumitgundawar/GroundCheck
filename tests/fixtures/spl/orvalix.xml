  <component>
    <structuredBody>
      <component>
        <section>
          <code code="48780-1"/>
          <subject>
            <manufacturedProduct>
              <manufacturedProduct>
                <name>Orvalix</name>
                <formCode code="C42986" displayName="SOLUTION"/>
                <asEntityWithGeneric><genericMedicine><name>orvalix sulfate</name></genericMedicine></asEntityWithGeneric>
                <ingredient classCode="ACTIB">
                  <quantity><numerator value="5" unit="mg"/><denominator value="1" unit="mL"/></quantity>
                  <ingredientSubstance><name>ORVALIX SULFATE</name></ingredientSubstance>
