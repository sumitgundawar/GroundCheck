          <code code="34067-9"/>
          <title>INDICATIONS AND USAGE</title>
          <text><paragraph>Dermaquil 1% cream is indicated for fictional dermal flushing.</paragraph></text>
        </section>
      </component>
      <component>
        <section>
          <code code="34068-7"/>
          <title>DOSAGE AND ADMINISTRATION</title>
          <text><paragraph>Apply a thin layer of Dermaquil 1% cream to the affected area twice daily. Use the 0.5% strength for patients with sensitive skin.</paragraph></text>
        </section>
