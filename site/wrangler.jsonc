{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A static site served by Workers static assets. The small Worker in
  // src/worker.js runs only for /media/*, to answer byte-range requests for
  // the demo video; everything else is served straight from ./public, with
  // _headers applied.
  "name": "groundcheckhealth",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/media/*"]
  },

  // Served only on the custom domain. workers.dev and preview URLs are off so
  // the site never appears under a second, indexable address.
  "routes": [{ "pattern": "groundcheckhealth.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true }
}
