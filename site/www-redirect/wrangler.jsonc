{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Redirects the www host to the apex domain. Kept separate from the site
  // Worker so the site itself stays a static-assets deployment.
  "name": "groundcheckhealth-www-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "www.groundcheckhealth.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
