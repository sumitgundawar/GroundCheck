# Applied by Cloudflare Workers static assets. See
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  # Six months, without includeSubDomains or preload. Both are hard to undo,
  # and belong to a deliberate decision once every subdomain is known.
  Strict-Transport-Security: max-age=15552000

# Fonts never change under the same file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
